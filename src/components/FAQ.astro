---
const questions = [
  {
    id: "politica-de-uso",
    question: "O que é considerado abuso pela política de uso?",
    answer:
      "Automações mal-intencionadas, geração de registros para sobrecarregar o sistema e outras ações de má-fé que prejudiquem o serviço.",
  },
  {
    question: "Em quais situações o suporte pode ajudar?",
    answer:
      "O suporte cobre dúvidas de uso, auxílio operacional e investigação de problemas no sistema.",
  },
  {
    question: "Preciso instalar alguma coisa?",
    answer:
      "Não. O sistema funciona pelo navegador e pode ser acessado diretamente pelo computador, celular ou tablet.",
  },
  {
    question: "Preciso de internet para usar o sistema?",
    answer:
      "Sim. É necessário estar conectado à internet para usar o sistema. Ele não funciona offline.",
  },
];
---

<section
  id="faq"
  class="border-y border-slate-200/80 bg-white py-20 dark:border-slate-800 dark:bg-slate-900 sm:py-24"
>
  <div class="mx-auto max-w-4xl px-5 sm:px-6 lg:px-8">
    <div data-reveal class="max-w-2xl">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
        Dúvidas frequentes
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
        Tudo claro antes de começar.
      </h2>
      <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">
        Tire suas dúvidas sobre acesso, suporte e uso do sistema.
      </p>
    </div>
    <div class="mt-10 divide-y divide-slate-200 dark:divide-slate-800">
      {questions.map(({ id, question, answer }, index) => (
        <details
          id={id}
          data-reveal
          class:list={[
            "faq-item group overflow-hidden py-5",
            { "first:pt-0": index === 0 },
          ]}
        >
          <summary class="flex cursor-pointer list-none items-center justify-between gap-4 text-left text-base font-semibold text-slate-900 dark:text-slate-100">
            {question}
            <span
              class="flex h-8 w-8 shrink-0 items-center justify-center rounded-lg bg-slate-100 text-slate-500 dark:bg-slate-800 dark:text-slate-400"
              aria-hidden="true"
            >
              <svg
                class="transition-transform duration-300 ease-out group-open:rotate-45"
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
              >
                <path d="M12 5v14"></path>
                <path d="M5 12h14"></path>
              </svg>
            </span>
          </summary>
          <div class="faq-answer">
            <p class="mt-3 max-w-3xl pr-12 text-sm leading-6 text-slate-500 dark:text-slate-400">
              {answer}
            </p>
          </div>
        </details>
      ))}
    </div>
  </div>
</section>

<script>
  const reduceMotion = window.matchMedia("(prefers-reduced-motion: reduce)");

  document.querySelectorAll<HTMLDetailsElement>(".faq-item").forEach((item) => {
    const summary = item.querySelector<HTMLElement>("summary");
    if (!summary) return;
    let animation: Animation | null = null;
    let expanded = item.open;

    const openFromLink = () => {
      animation?.cancel();
      animation = null;
      expanded = true;
      item.open = true;
      item.classList.add("is-visible");
    };

    if (item.id) {
      document
        .querySelectorAll<HTMLAnchorElement>(`a[href="#${item.id}"]`)
        .forEach((link) => {
          link.addEventListener("click", () => {
            openFromLink();
            summary.focus({ preventScroll: true });
          });
        });
      const openFromHash = () => {
        if (window.location.hash === `#${item.id}`) openFromLink();
      };
      window.addEventListener("hashchange", openFromHash);
      openFromHash();
    }

    summary.addEventListener("click", (event) => {
      event.preventDefault();
      const startHeight = item.getBoundingClientRect().height;
      animation?.cancel();
      expanded = !expanded;

      if (reduceMotion.matches) {
        item.open = expanded;
        return;
      }

      // Measure the actual closed box, including its padding and borders.
      item.open = expanded;
      const endHeight = item.getBoundingClientRect().height;
      item.open = true;
      animation = item.animate(
        { height: [`${startHeight}px`, `${endHeight}px`] },
        { duration: 280, easing: "cubic-bezier(0.4, 0, 0.2, 1)", fill: "both" },
      );
      animation.onfinish = () => {
        item.open = expanded;
        animation?.cancel();
        animation = null;
      };
    });
  });
</script>

<style>
  .faq-item summary {
    border-radius: 0.75rem;
    transition: color 180ms ease;
  }
</style>
