---
import { urls } from "../config/urls";
---

<div>
  <section class="relative overflow-hidden">
    <div
      class="hero-grid pointer-events-none absolute inset-x-0 top-0 -z-20 h-[700px]"
      aria-hidden="true"
    ></div>

    <div
      class="hero-glow pointer-events-none absolute -right-52 top-20 -z-10 h-[600px] w-[600px] rounded-full"
      aria-hidden="true"
    ></div>

    <div class="mx-auto grid max-w-7xl items-center gap-14 px-5 pb-20 pt-16 sm:px-6 sm:pt-20 lg:grid-cols-[0.9fr_1.1fr] lg:gap-16 lg:px-8 lg:pb-28 lg:pt-24">
      <div data-reveal class="max-w-2xl">
        <h1 class="text-[clamp(2.7rem,7vw,4.75rem)] font-bold leading-[0.98] tracking-[-0.045em] text-slate-950 dark:text-white">
          Seu estoque sob controle.
          <span class="text-brand-600 dark:text-brand-400">
            {" "}
            Sem complicação.
          </span>
        </h1>

        <p class="mt-6 max-w-xl text-base leading-7 text-slate-600 dark:text-slate-300 sm:text-lg sm:leading-8">
          Substitua papéis, contas manuais e sistemas complicados por uma visão
          clara da sua operação, com implantação padrão, treinamento inicial e
          suporte direto de quem desenvolve o sistema.
        </p>

        <div class="mt-8 flex flex-col gap-3 sm:flex-row">
          <a
            href={urls.sales}
            target="_blank"
            rel="noopener noreferrer"
            class="inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md"
          >
            Falar com a equipe de vendas
            <svg
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>

          <a
            href="#como-funciona"
            class="inline-flex h-12 items-center justify-center rounded-xl border border-slate-200 bg-white px-6 text-sm font-semibold text-slate-700 shadow-sm transition duration-200 hover:-translate-y-0.5 hover:border-slate-300 hover:bg-slate-50 hover:text-slate-950 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-200 dark:hover:border-slate-600 dark:hover:bg-slate-800 dark:hover:text-white"
          >
            Conhecer o sistema
          </a>
        </div>

      </div>

      <div data-reveal class="hero-preview relative lg:pl-2">
        <div
          class="absolute -inset-4 -z-10 rounded-[2rem] bg-brand-500/5 blur-2xl dark:bg-brand-500/10"
          aria-hidden="true"
        ></div>

        <div class="relative overflow-hidden rounded-[1.6rem] border border-slate-200/80 bg-white shadow-[0_30px_80px_-35px_rgb(15_23_42/0.35)] dark:border-slate-800 dark:bg-slate-900 dark:shadow-[0_30px_80px_-35px_rgb(0_0_0/0.75)]">
          <div class="flex h-12 items-center justify-between border-b border-slate-200/80 bg-slate-50/80 px-4 dark:border-slate-800 dark:bg-slate-950/70">
            <div class="flex items-center gap-1.5" aria-hidden="true">
              <span class="h-2.5 w-2.5 rounded-full bg-red-400 dark:bg-red-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-amber-400 dark:bg-amber-500"></span>
              <span class="h-2.5 w-2.5 rounded-full bg-emerald-400 dark:bg-emerald-500"></span>
            </div>

            <span class="rounded-lg border border-slate-200 bg-white px-3 py-1 font-mono text-[10px] text-slate-600 dark:border-slate-700 dark:bg-slate-900 dark:text-slate-300">
              gestaoestoque.app/dashboard
            </span>

            <div class="w-10"></div>
          </div>

          <div class="p-4 sm:p-6">
            <div class="flex items-start gap-3">
              <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-brand-100 text-brand-700 dark:bg-brand-950 dark:text-brand-300">
                <svg
                  width="20"
                  height="20"
                  viewBox="0 0 24 24"
                  fill="none"
                  stroke="currentColor"
                  stroke-width="2"
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  aria-hidden="true"
                >
                  <rect width="7" height="9" x="3" y="3" rx="1"></rect>
                  <rect width="7" height="5" x="14" y="3" rx="1"></rect>
                  <rect width="7" height="9" x="14" y="12" rx="1"></rect>
                  <rect width="7" height="5" x="3" y="16" rx="1"></rect>
                </svg>
              </span>

              <div>
                <p class="text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                  Dashboard
                </p>

                <div class="mt-2 border-l-2 border-brand-500 pl-2.5">
                  <p class="text-xs font-semibold text-slate-700 dark:text-slate-200">
                    Seu estabelecimento
                  </p>

                  <p class="mt-0.5 text-[10px] text-slate-600 dark:text-slate-300">
                    Acompanhe alertas de estoque, resultados de vendas e
                    produtos que precisam de atenção.
                  </p>
                </div>
              </div>
            </div>

            <div class="mt-7">
              <p class="text-[9px] font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
                Resumo
              </p>

              <h2 class="mt-1 text-sm font-bold tracking-tight text-slate-950 dark:text-white">
                Informações rápidas
              </h2>

              <div class="mt-3 grid w-full grid-cols-3 gap-2 sm:grid-cols-6">
                <article class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-info-50 text-info-700 dark:bg-info-950/60 dark:text-info-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m7.5 4.27 9 5.15"></path>
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l7-4A2 2 0 0 0 21 16Z"></path>
                      <path d="m3.3 7 8.7 5 8.7-5"></path>
                      <path d="M12 22V12"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    248
                  </p>

                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Produtos cadastrados
                  </p>

                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    Itens no catálogo
                  </p>
                </article>

                <article class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-secondary-50 text-secondary-700 dark:bg-secondary-950/60 dark:text-secondary-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <rect width="18" height="18" x="3" y="3" rx="2"></rect>
                      <path d="M3 9h18"></path>
                      <path d="M3 15h18"></path>
                      <path d="M9 3v18"></path>
                      <path d="M15 3v18"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    18
                  </p>

                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Categorias
                  </p>

                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    Organização do catálogo
                  </p>
                </article>

                <article class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-success-50 text-success-700 dark:bg-success-950/60 dark:text-success-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M21.801 10A10 10 0 1 1 17 3.335"></path>
                      <path d="m9 11 3 3L22 4"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    184
                  </p>

                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Vendas concluídas
                  </p>

                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    Total registrado
                  </p>
                </article>

                <article class="min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-error-50 text-error-700 dark:bg-error-950/60 dark:text-error-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <circle cx="12" cy="12" r="10"></circle>
                      <path d="m15 9-6 6"></path>
                      <path d="m9 9 6 6"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    7
                  </p>
                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Vendas canceladas
                  </p>
                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    Total cancelado
                  </p>
                </article>

                <article class="stock-alert-card stock-alert-card--low min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-warning-50 text-warning-700 dark:bg-warning-950/60 dark:text-warning-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m21.73 18-8-14a2 2 0 0 0-3.46 0l-8 14A2 2 0 0 0 4 21h16a2 2 0 0 0 1.73-3"></path>
                      <path d="M12 9v4"></path>
                      <path d="M12 17h.01"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    6
                  </p>
                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Estoque baixo
                  </p>
                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    De 1 a 5 unidades
                  </p>
                </article>

                <article class="stock-alert-card stock-alert-card--out min-w-0 rounded-2xl border border-slate-200/80 bg-white p-2.5 shadow-sm dark:border-slate-800 dark:bg-slate-900">
                  <span class="flex h-7 w-7 items-center justify-center rounded-xl bg-error-50 text-error-700 dark:bg-error-950/60 dark:text-error-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="m7.5 4.27 9 5.15"></path>
                      <path d="M21 8a2 2 0 0 0-1-1.73l-7-4a2 2 0 0 0-2 0l-7 4A2 2 0 0 0 3 8v8a2 2 0 0 0 1 1.73l7 4a2 2 0 0 0 2 0l2-1.14"></path>
                      <path d="m3.3 7 8.7 5 8.7-5"></path>
                      <path d="M12 22V12"></path>
                      <path d="m17 13 5 5"></path>
                      <path d="m22 13-5 5"></path>
                    </svg>
                  </span>

                  <p class="mt-2.5 text-lg font-bold tracking-tight text-slate-950 dark:text-white">
                    3
                  </p>
                  <p class="mt-0.5 text-[9px] font-semibold leading-3.5 text-slate-600 dark:text-slate-300">
                    Sem estoque
                  </p>
                  <p class="mt-0.5 text-[8px] leading-3 text-slate-600 dark:text-slate-300">
                    Produtos esgotados
                  </p>
                </article>
              </div>
            </div>

            <div class="mt-4 rounded-2xl border border-slate-200/80 bg-white p-4 shadow-sm dark:border-slate-800 dark:bg-slate-900">
              <div class="flex items-start justify-between gap-3">
                <div class="flex items-start gap-2.5">
                  <span class="flex h-8 w-8 shrink-0 items-center justify-center rounded-xl bg-brand-50 text-brand-700 dark:bg-brand-950/60 dark:text-brand-300">
                    <svg
                      width="16"
                      height="16"
                      viewBox="0 0 24 24"
                      fill="none"
                      stroke="currentColor"
                      stroke-width="2"
                      stroke-linecap="round"
                      stroke-linejoin="round"
                      aria-hidden="true"
                    >
                      <path d="M3 3v18h18"></path>
                      <path d="M18 17V9"></path>
                      <path d="M13 17V5"></path>
                      <path d="M8 17v-3"></path>
                    </svg>
                  </span>

                  <div>
                    <p class="text-xs font-bold text-slate-900 dark:text-slate-100">
                      Evolução das vendas
                    </p>

                    <p class="mt-0.5 text-[9px] text-slate-600 dark:text-slate-300">
                      Faturamento e vendas concluídas ao longo do período
                    </p>
                  </div>
                </div>

                <div
                  class="flex shrink-0 items-center gap-1"
                  role="group"
                  aria-label="Período do gráfico de vendas"
                >
                  <span class="rounded-lg bg-slate-100 px-1.5 py-1.5 text-[8px] font-semibold whitespace-nowrap text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    1 ano
                  </span>
                  <span class="rounded-lg bg-slate-100 px-1.5 py-1.5 text-[8px] font-semibold whitespace-nowrap text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    6 meses
                  </span>
                  <span class="rounded-lg bg-slate-100 px-1.5 py-1.5 text-[8px] font-semibold whitespace-nowrap text-slate-600 dark:bg-slate-800 dark:text-slate-300">
                    30 dias
                  </span>
                  <span
                    class="rounded-lg bg-brand-600 px-1.5 py-1.5 text-[8px] font-semibold whitespace-nowrap text-white shadow-sm"
                    aria-current="true"
                  >
                    7 dias
                  </span>
                </div>
              </div>

              <div class="mt-4 flex items-end justify-between gap-3">
                <div>
                  <p class="text-[9px] font-medium text-slate-500 dark:text-slate-300">
                    Faturamento no período
                  </p>

                  <p class="mt-0.5 text-base font-bold tracking-tight text-slate-950 dark:text-white">
                    R$ 12.480,00
                  </p>
                </div>

                <span class="rounded-full bg-brand-50 px-2.5 py-1 text-[9px] font-semibold text-brand-700 dark:bg-brand-950/60 dark:text-brand-300">
                  184 vendas
                </span>
              </div>

              <div class="mt-3">
                <svg
                  viewBox="0 0 520 180"
                  class="h-auto w-full"
                  role="img"
                  aria-label="Prévia da evolução das vendas"
                >
                  <defs>
                    <linearGradient
                      id="preview-sales-area-gradient"
                      x1="0"
                      x2="0"
                      y1="0"
                      y2="1"
                    >
                      <stop
                        offset="0%"
                        stop-color="#10b981"
                        stop-opacity="0.3"
                      ></stop>
                      <stop
                        offset="100%"
                        stop-color="#10b981"
                        stop-opacity="0.02"
                      ></stop>
                    </linearGradient>
                  </defs>

                  <g class="stroke-slate-200 dark:stroke-slate-800">
                    <line
                      x1="42"
                      x2="508"
                      y1="20"
                      y2="20"
                      stroke-width="1"
                      stroke-dasharray="4 6"
                    ></line>
                    <line
                      x1="42"
                      x2="508"
                      y1="55"
                      y2="55"
                      stroke-width="1"
                      stroke-dasharray="4 6"
                    ></line>
                    <line
                      x1="42"
                      x2="508"
                      y1="90"
                      y2="90"
                      stroke-width="1"
                      stroke-dasharray="4 6"
                    ></line>
                    <line
                      x1="42"
                      x2="508"
                      y1="125"
                      y2="125"
                      stroke-width="1"
                      stroke-dasharray="4 6"
                    ></line>
                  </g>

                  <g
                    class="fill-slate-400 dark:fill-slate-300"
                    font-size="9"
                    font-weight="500"
                  >
                    <text x="34" y="24" text-anchor="end">
                      R$ 3k
                    </text>
                    <text x="34" y="59" text-anchor="end">
                      R$ 2k
                    </text>
                    <text x="34" y="94" text-anchor="end">
                      R$ 1k
                    </text>
                    <text x="34" y="129" text-anchor="end">
                      R$ 0
                    </text>
                  </g>

                  <path
                    d="M 48 108 L 122 88 L 198 101 L 274 65 L 350 78 L 426 43 L 502 26 L 502 125 L 48 125 Z"
                    fill="url(#preview-sales-area-gradient)"
                  ></path>

                  <path
                    d="M 48 108 L 122 88 L 198 101 L 274 65 L 350 78 L 426 43 L 502 26"
                    fill="none"
                    stroke="#059669"
                    stroke-width="3"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                  ></path>

                  <g
                    class="fill-white dark:fill-slate-900"
                    stroke="#059669"
                    stroke-width="2.5"
                  >
                    <circle cx="48" cy="108" r="3.5"></circle>
                    <circle cx="122" cy="88" r="3.5"></circle>
                    <circle cx="198" cy="101" r="3.5"></circle>
                    <circle cx="274" cy="65" r="3.5"></circle>
                    <circle cx="350" cy="78" r="3.5"></circle>
                    <circle cx="426" cy="43" r="3.5"></circle>
                    <circle cx="502" cy="26" r="3.5"></circle>
                  </g>

                  <g
                    class="fill-slate-400 dark:fill-slate-300"
                    font-size="9"
                    font-weight="500"
                  >
                    <text x="48" y="153" text-anchor="start">
                      08/09
                    </text>
                    <text x="122" y="153" text-anchor="middle">
                      09/09
                    </text>
                    <text x="198" y="153" text-anchor="middle">
                      10/09
                    </text>
                    <text x="274" y="153" text-anchor="middle">
                      11/09
                    </text>
                    <text x="350" y="153" text-anchor="middle">
                      12/09
                    </text>
                    <text x="426" y="153" text-anchor="middle">
                      13/09
                    </text>
                    <text x="502" y="153" text-anchor="end">
                      14/09
                    </text>
                  </g>
                </svg>
              </div>
            </div>
          </div>
        </div>

        <aside class="relative z-30 mx-4 -mt-7 overflow-hidden rounded-2xl border border-slate-200/80 bg-slate-50 px-4 py-3.5 text-slate-900 shadow-[0_16px_40px_-20px_rgb(15_23_42/0.15)] dark:border-slate-700/80 dark:bg-slate-950 dark:text-white dark:shadow-[0_16px_40px_-20px_rgb(15_23_42/0.9)] sm:mx-8">
          <span class="absolute inset-x-10 top-0 h-px bg-gradient-to-r from-transparent via-brand-200/60 to-transparent dark:via-brand-400/80"></span>
          <span class="absolute -top-8 left-1/2 h-14 w-40 -translate-x-1/2 rounded-full bg-brand-500/5 blur-2xl dark:bg-brand-500/10"></span>

          <div class="relative flex items-center gap-3">
            <span class="flex h-9 w-9 shrink-0 items-center justify-center rounded-xl border border-brand-200/60 bg-brand-50 text-brand-600 dark:border-brand-400/20 dark:bg-brand-400/10 dark:text-brand-300">
              <svg
                width="16"
                height="16"
                viewBox="0 0 24 24"
                fill="none"
                stroke="currentColor"
                stroke-width="2"
                stroke-linecap="round"
                stroke-linejoin="round"
                aria-hidden="true"
              >
                <path d="M3 3v18h18"></path>
                <path d="M8 17v-3"></path>
                <path d="M13 17V9"></path>
                <path d="M18 17V5"></path>
              </svg>
            </span>

            <div class="min-w-0">
              <p class="text-xs font-semibold leading-4 text-slate-900 dark:text-white sm:text-[13px] sm:leading-5">
                Esta é apenas uma prévia do dashboard.
              </p>
              <p class="mt-0.5 text-[10px] leading-4 text-slate-600 dark:text-slate-400 sm:text-[11px] sm:leading-[1.125rem]">
                Analise vendas por categoria, produtos mais vendidos, itens sem
                giro e outros indicadores da sua operação.
              </p>
            </div>
          </div>
        </aside>
      </div>
    </div>
  </section>
</div>

<style>
  .stock-alert-card {
    --dashboard-alert-rest: rgb(148 163 184 / 0.45);
    border-color: var(--dashboard-alert-rest);
  }

  .stock-alert-card--low {
    --dashboard-alert-rest: rgb(237 108 2 / 0.42);
  }

  .stock-alert-card--out {
    --dashboard-alert-rest: rgb(211 47 47 / 0.42);
  }
</style>
