---
import { urls } from "../config/urls";

const features = [
  "1 estabelecimento e até 10 usuários",
  "Produtos, categorias, vendas e movimentações sem limite comercial*",
  "Histórico, relatórios e exportações ilimitados",
  "Backup diário, semanal e mensal",
  "Atualizações corretivas incluídas",
  "Suporte em horário comercial, com contato direto com quem desenvolve",
  "Implantação padrão e um treinamento inicial",
];
---

<section
  id="plano"
  class="border-t border-slate-200/80 bg-white py-20 dark:border-slate-800 dark:bg-slate-900 sm:py-24"
>
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div data-reveal class="mx-auto max-w-2xl text-center">
      <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
        Conheça o plano
      </p>
      <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
        Tudo o que sua operação precisa em um único plano.
      </h2>
      <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-400">
        Gestão de estoque e vendas para sua operação começar organizada e
        crescer com acompanhamento próximo.
      </p>
    </div>

    <div class="mx-auto mt-10 max-w-xl">
      <article
        data-reveal
        class="plan-card interactive-card relative overflow-hidden rounded-3xl border border-brand-200 bg-white p-6 shadow-[0_24px_70px_-35px_rgb(37_99_235/0.45)] dark:border-brand-900/70 dark:bg-slate-900 sm:p-8"
      >
        <div
          class="pointer-events-none absolute -right-24 -top-24 h-56 w-56 rounded-full bg-brand-500/10 blur-3xl"
          aria-hidden="true"
        ></div>
        <div class="relative">
          <div class="flex flex-col gap-3 sm:flex-row sm:items-start sm:justify-between">
            <div>
              <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
                Plano Gestão Completa
              </p>
            </div>
            <span class="w-fit rounded-full bg-success-50 px-3 py-1 text-xs font-semibold text-success-700 dark:bg-success-950/60 dark:text-success-300">
              Implantação incluída
            </span>
          </div>

          <div class="mt-8">
            <div class="flex items-end gap-2">
              <span class="text-4xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-5xl">
                R$ 399
              </span>
              <span class="pb-1 text-sm font-medium text-slate-500 dark:text-slate-400">
                /mês
              </span>
            </div>
            <div class="mt-4 flex flex-col items-center gap-1.5 rounded-2xl border border-brand-100 bg-brand-50/70 px-4 py-5 text-center dark:border-brand-900/60 dark:bg-brand-950/30">
              <p class="text-sm font-semibold text-slate-900 dark:text-slate-100">
                Plano anual por R$ 349/mês
              </p>
              <p class="text-base font-bold text-success-700 dark:text-success-300">
                Economize R$ 600 por ano
              </p>
            </div>
          </div>

          <ul class="mt-8 space-y-3.5">
            {features.map((feature) => (
              <li class="flex items-start gap-3 text-sm text-slate-700 dark:text-slate-300">
                <span class="mt-0.5 flex h-5 w-5 shrink-0 items-center justify-center rounded-full bg-success-50 text-success-700 dark:bg-success-950/60 dark:text-success-300">
                  <svg
                    width="13"
                    height="13"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="2.5"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="m5 12 4 4L19 6"></path>
                  </svg>
                </span>
                {feature}
              </li>
            ))}
          </ul>

          <div class="mt-5 rounded-xl border border-slate-200 bg-slate-50/70 px-4 py-3 dark:border-slate-800 dark:bg-slate-800/40">
            <p class="text-xs leading-5 text-slate-500 dark:text-slate-400">
              *Sem limites para o uso normal da operação. A política de uso
              protege o serviço contra abusos e não restringe o crescimento
              legítimo do seu negócio.
            </p>
            <a
              href="#politica-de-uso"
              class="mt-2 block text-center text-xs font-semibold text-brand-700 underline decoration-brand-300 underline-offset-4 transition-colors hover:text-brand-600 dark:text-brand-300 dark:hover:text-brand-200"
            >
              Entenda a política de uso
            </a>
          </div>

          <a
            href={urls.sales}
            target="_blank"
            rel="noopener noreferrer"
            class="mt-8 inline-flex h-12 w-full items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md"
          >
            Falar com a equipe de vendas
            <svg
              class="plan-arrow transition-transform duration-300"
              width="17"
              height="17"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="2"
              stroke-linecap="round"
              stroke-linejoin="round"
              aria-hidden="true"
            >
              <path d="M5 12h14"></path>
              <path d="m13 6 6 6-6 6"></path>
            </svg>
          </a>
          <p class="mt-4 text-center text-xs leading-5 text-slate-500 dark:text-slate-400">
            Plano mensal sem permanência mínima. No plano anual, o compromisso
            mínimo é de 12 meses, mesmo com pagamento mensal.
          </p>
          <div class="mt-5 border-t border-slate-200 pt-5 dark:border-slate-800">
            <p class="text-center text-xs font-semibold uppercase tracking-[0.14em] text-slate-500 dark:text-slate-400">
              Adicione quando precisar
            </p>
            <div class="mt-3 grid gap-3 sm:grid-cols-2">
              <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-700 dark:bg-slate-800/50">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm dark:bg-slate-900 dark:text-brand-300" aria-hidden="true">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M16 21v-2a4 4 0 0 0-4-4H6a4 4 0 0 0-4 4v2"></path>
                    <circle cx="9" cy="7" r="4"></circle>
                    <path d="M19 8v6"></path><path d="M22 11h-6"></path>
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Usuário adicional</p>
                  <p class="mt-0.5 font-bold text-slate-950 dark:text-white">R$ 20 <span class="text-xs font-medium text-slate-500 dark:text-slate-400">/mês</span></p>
                </div>
              </div>
              <div class="flex items-center gap-3 rounded-2xl border border-slate-200 bg-slate-50/70 p-4 dark:border-slate-700 dark:bg-slate-800/50">
                <span class="flex h-10 w-10 shrink-0 items-center justify-center rounded-xl bg-white text-brand-700 shadow-sm dark:bg-slate-900 dark:text-brand-300" aria-hidden="true">
                  <svg width="19" height="19" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                    <path d="M3 9 5 4h14l2 5"></path>
                    <path d="M5 13v7h14v-7"></path>
                    <path d="M9 20v-6h6v6"></path>
                    <path d="M3 9a3 3 0 0 0 6 0 3 3 0 0 0 6 0 3 3 0 0 0 6 0"></path>
                  </svg>
                </span>
                <div>
                  <p class="text-xs font-medium text-slate-500 dark:text-slate-400">Estabelecimento adicional</p>
                  <p class="mt-0.5 font-bold text-slate-950 dark:text-white">R$ 149 <span class="text-xs font-medium text-slate-500 dark:text-slate-400">/mês</span></p>
                </div>
              </div>
            </div>
          </div>
        </div>
      </article>
    </div>
  </div>
</section>

<style>
  @media (hover: hover) and (prefers-reduced-motion: no-preference) {
    .plan-card:hover .plan-arrow {
      transform: translateX(4px);
    }
  }
</style>
