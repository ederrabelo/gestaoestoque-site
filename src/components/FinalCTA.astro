---
import { urls } from "../config/urls";
---

<section class="py-20 sm:py-24">
  <div class="mx-auto max-w-7xl px-5 sm:px-6 lg:px-8">
    <div
      data-reveal
      class="interactive-card relative overflow-hidden rounded-3xl border border-brand-200 bg-brand-50 px-6 py-12 text-center dark:border-brand-900/70 dark:bg-brand-950/30 sm:px-10 sm:py-14"
    >
      <div
        class="pointer-events-none absolute left-1/2 top-0 h-72 w-72 -translate-x-1/2 -translate-y-1/2 rounded-full bg-brand-500/15 blur-3xl"
        aria-hidden="true"
      ></div>
      <div class="relative mx-auto max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-[0.18em] text-brand-700 dark:text-brand-400">
          Vamos conversar
        </p>
        <h2 class="mt-2 text-3xl font-bold tracking-tight text-slate-950 dark:text-white sm:text-4xl">
          Sua equipe pode trabalhar com mais clareza.
        </h2>
        <p class="mt-4 text-base leading-7 text-slate-600 dark:text-slate-300">
          Fale diretamente com nossa equipe, conheça o sistema e descubra como
          levar sua operação do improviso para uma gestão simples e organizada.
        </p>
        <a
          href={urls.sales}
          target="_blank"
          rel="noopener noreferrer"
          class="mt-7 inline-flex h-12 items-center justify-center gap-2 rounded-xl bg-brand-600 px-6 text-sm font-semibold text-white shadow-sm transition duration-200 hover:-translate-y-0.5 hover:bg-brand-700 hover:shadow-md"
        >
          Falar com a equipe de vendas
          <svg
            width="17"
            height="17"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="2"
            stroke-linecap="round"
            stroke-linejoin="round"
            aria-hidden="true"
          >
            <path d="M5 12h14"></path>
            <path d="m13 6 6 6-6 6"></path>
          </svg>
        </a>
        <p class="mt-4 text-xs text-slate-700 dark:text-slate-300">
          Atendimento humano pelo WhatsApp, sem formulários ou respostas
          automáticas.
        </p>
      </div>
    </div>
  </div>
</section>
