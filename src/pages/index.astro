---
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import BeforeAfter from "../components/BeforeAfter.astro";
import Pricing from "../components/Pricing.astro";
import FAQ from "../components/FAQ.astro";
import FinalCTA from "../components/FinalCTA.astro";
import Footer from "../components/Footer.astro";
---

<BaseLayout
  title="Sistema de gestão de estoque e vendas | gestaoestoque.app"
  description="Controle de estoque e vendas com indicadores, implantação acompanhada e suporte humano direto."
>
  <Header />

  <main id="conteudo">
    <Hero />
    <BeforeAfter />
    <Pricing />
    <FAQ />
    <FinalCTA />
  </main>

  <Footer />
</BaseLayout>
