---
import "@fontsource-variable/geist/wght.css";
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Sistema de gestão de estoque e vendas | gestaoestoque.app",
  description = "Controle de estoque e vendas com indicadores, implantação acompanhada e suporte humano direto.",
} = Astro.props;

const structuredData = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  name: "gestaoestoque.app",
  applicationCategory: "BusinessApplication",
  operatingSystem: "Web",
  description,
  offers: {
    "@type": "Offer",
    price: "799.00",
    priceCurrency: "BRL",
  },
};
---

<!doctype html>
<html lang="pt-BR">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />

    <meta name="description" content={description} />
    <meta name="robots" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="googlebot" content="noindex, nofollow, noarchive, nosnippet" />
    <meta name="theme-color" content="#f8fafc" />

    <meta property="og:type" content="website" />
    <meta property="og:locale" content="pt_BR" />
    <meta property="og:site_name" content="gestaoestoque.app" />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta name="twitter:card" content="summary" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />

    <link rel="icon" type="image/svg+xml" href="/icon.svg" />

    <script is:inline>
      document.documentElement.classList.add("motion-ready");
    </script>
    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(structuredData)}
    ></script>
  </head>

  <body>
    <a
      href="#conteudo"
      class="fixed left-4 top-4 z-[100] -translate-y-24 rounded-lg bg-slate-950 px-4 py-2 text-sm font-semibold text-white transition-transform focus:translate-y-0 dark:bg-white dark:text-slate-950"
    >
      Ir para o conteúdo
    </a>
    <slot />
    <script>
      const animatedItems =
        document.querySelectorAll<HTMLElement>("[data-reveal]");
      const reduceMotion = window.matchMedia(
        "(prefers-reduced-motion: reduce)",
      ).matches;

      if (reduceMotion || !("IntersectionObserver" in window)) {
        animatedItems.forEach((item) => item.classList.add("is-visible"));
      } else {
        const observer = new IntersectionObserver(
          (entries) => {
            entries.forEach((entry) => {
              if (!entry.isIntersecting) return;
              entry.target.classList.add("is-visible");
              observer.unobserve(entry.target);
            });
          },
          { threshold: 0.12, rootMargin: "0px 0px -40px" },
        );

        animatedItems.forEach((item, index) => {
          item.style.transitionDelay = `${Math.min(index % 4, 3) * 55}ms`;
          observer.observe(item);
        });
      }
    </script>
  </body>
</html>
